---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { copy, isLocale, locales, pageSlugs, type Locale } from '../../data/content';
import { legalContact, policyReviewComplete } from '../../data/legal';

type Page = 'calculators' | 'privacy' | 'cookies';
export function getStaticPaths() {
  return locales.flatMap((locale) => (Object.entries(pageSlugs[locale]) as Array<[Page, string]>).map(([page, slug]) => ({ params: { lang: locale, slug }, props: { page } })));
}
const localeParam = Astro.params.lang ?? '';
if (!isLocale(localeParam)) return Astro.redirect('/404/');
const locale = localeParam as Locale;
const page = Astro.props.page as Page;
const t = copy[locale];
const slugTitle = page === 'calculators' ? t.calculatorPageTitle : page === 'privacy' ? t.privacyTitle : t.cookieTitle;
---
<SiteLayout locale={locale} page={page} active={page === 'calculators' ? 'calculators' : undefined} title={`${slugTitle} | GMC`} description={page === 'calculators' ? t.calculatorPageDescription : undefined}>
  {page === 'calculators' ? (
    <main id="main" class="calculators-page">
      <section class="page-hero section-wrap">
        <div><p class="eyebrow"><span class="eyebrow-dot"></span>{t.calculatorIntro}</p><h1>{t.calculatorTitle}</h1></div>
        <p>{t.calculatorBody}</p>
        <span class="page-hero-index">07 <small>TOOLS</small></span>
      </section>
      <section class="calculator-grid section-wrap" aria-label={t.calculatorPageTitle}>
        {t.calculatorItems.map(([title, description, domain], index) => (
          <a class="calculator-card" href={`https://${domain}`} target="_blank" rel="noopener noreferrer" data-analytics-event="calculator_open" data-analytics-name={domain}>
            <span class="calculator-number">0{index + 1}</span>
            <span class="calculator-icon" aria-hidden="true">{['↗', '⌁', '◌', '⌘', '∿', '⌖', '◷'][index]}</span>
            <span class="calculator-card-content"><strong>{title}</strong><span>{description}</span><small>{t.openTool} <i aria-hidden="true">↗</i></small></span>
          </a>
        ))}
      </section>
      <section class="calculator-note section-wrap"><span class="note-mark">i</span><p>{t.external}</p><a class="text-link" href={`mailto:giovanni@giovannimalagninoconsulting.com?subject=${encodeURIComponent(t.calculatorPageTitle)}`}>{t.contactEyebrow}<span aria-hidden="true">↗</span></a></section>
    </main>
  ) : (
    <main id="main" class="policy-page section-wrap">
      <p class="eyebrow"><span class="eyebrow-dot"></span>{t.policyTitle}</p>
      <h1>{page === 'privacy' ? t.privacyTitle : t.cookieTitle}</h1>
      <p class="policy-lede">{page === 'privacy' ? t.privacyLead : t.cookieLead}</p>
      {!policyReviewComplete && <aside class="draft-notice"><strong>{locale === 'fr' ? 'À compléter avant publication' : locale === 'en' ? 'Complete before publication' : 'Da completare prima della pubblicazione'}</strong><p>{t.policyDraft}</p></aside>}
      <div class="policy-body">
        {page === 'privacy' ? (
          <>
            <section><h2>{t.necessaryTitle}</h2><p>{t.necessaryText}</p><ul><li>{locale === 'fr' ? 'Cookie de consentement gmc_consent, conservé 180 jours.' : locale === 'en' ? 'Consent cookie gmc_consent, kept for 180 days.' : 'Cookie di consenso gmc_consent, conservato per 180 giorni.'}</li></ul></section>
            <section><h2>{t.analyticsTitle}</h2><p>{t.analyticsText}</p><ul><li>{locale === 'fr' ? 'Google Analytics est désactivé tant que vous n’avez pas choisi la mesure d’audience.' : locale === 'en' ? 'Google Analytics stays disabled until you opt into audience measurement.' : 'Google Analytics rimane disattivato finché non acconsentite alla misurazione.'}</li><li>{locale === 'fr' ? 'Les polices sont hébergées avec le site; aucune requête vers Google Fonts n’est faite depuis votre navigateur.' : locale === 'en' ? 'Fonts are served from this site; your browser does not request them from Google Fonts.' : 'I font sono ospitati su questo sito; il browser non li richiede a Google Fonts.'}</li></ul></section>
            <section><h2>{locale === 'fr' ? 'Responsable et contact' : locale === 'en' ? 'Controller and contact' : 'Titolare e contatto'}</h2><p>{legalContact.businessName} · <a href={`mailto:${legalContact.email}`}>{legalContact.email}</a></p>{legalContact.postalAddress && <p>{legalContact.postalAddress}</p>}</section>
            <section><h2>{locale === 'fr' ? 'Vos choix' : locale === 'en' ? 'Your choices' : 'Le vostre scelte'}</h2><p>{t.manageText}</p><button class="button button-dark policy-manage" type="button" data-consent-open>{t.cookiePrefs}</button></section>
          </>
        ) : (
          <>
            <section><h2>{t.necessaryTitle}</h2><p>{t.necessaryText}</p><div class="cookie-table"><span>gmc_consent</span><span>{locale === 'fr' ? 'Mémorise votre choix' : locale === 'en' ? 'Remembers your choice' : 'Memorizza la scelta'}</span><span>180 {locale === 'fr' ? 'jours' : locale === 'it' ? 'giorni' : 'days'}</span></div></section>
            <section><h2>{t.analyticsTitle}</h2><p>{t.analyticsText}</p><div class="cookie-table"><span>_ga, _ga_*</span><span>Google Analytics 4</span><span>180 {locale === 'fr' ? 'jours' : locale === 'it' ? 'giorni' : 'days'}</span></div></section>
            <section><h2>{t.manageTitle}</h2><p>{t.manageText}</p><button class="button button-dark policy-manage" type="button" data-consent-open>{t.cookiePrefs}</button></section>
            <section><h2>{locale === 'fr' ? 'Responsable du site' : locale === 'en' ? 'Site controller' : 'Titolare del sito'}</h2><p>{legalContact.businessName} · <a href={`mailto:${legalContact.email}`}>{legalContact.email}</a></p></section>
          </>
        )}
      </div>
    </main>
  )}
</SiteLayout>
