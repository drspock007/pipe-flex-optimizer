---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { copy, isLocale, locales, paths, type Locale } from '../../data/content';
export function getStaticPaths() { return locales.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang ?? 'fr';
if (!isLocale(lang)) return Astro.redirect('/404/');
const locale = lang as Locale;
const t = copy[locale];
---
<SiteLayout locale={locale} page="home" active="home">
  <main id="main">
    <section class="hero-section">
      <div class="hero-gridline" aria-hidden="true"></div>
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-dot"></span>{t.eyebrow}</p>
        <h1>{t.heroTitle}</h1>
        <p class="hero-lede">{t.heroText}</p>
        <div class="hero-actions">
          <a class="button button-orange" href="#contact" data-analytics-event="contact_cta" data-analytics-name="hero">{t.heroPrimary}<span aria-hidden="true">↗</span></a>
          <a class="text-link" href={paths.calculators(locale)} data-analytics-event="calculators_cta" data-analytics-name="hero">{t.heroSecondary}<span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hero-art" aria-label={t.serviceItems[0][1]} role="img">
        <div class="art-topline"><span>GMC / ENGINEERING</span><span>01 — 03</span></div>
        <svg viewBox="0 0 660 420" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M54 235H206C245 235 250 146 291 146H368C413 146 418 276 460 276H606" stroke="#F18732" stroke-width="20" stroke-linecap="round"/>
          <path d="M52 266H198C247 266 260 177 297 177H363C402 177 416 307 463 307H608" stroke="#FFFFFF" stroke-opacity=".35" stroke-width="2" stroke-dasharray="8 12"/>
          <path d="M55 189V281M607 230V321" stroke="#FFFFFF" stroke-width="7"/>
          <circle cx="330" cy="161" r="91" stroke="#FFFFFF" stroke-opacity=".13"/>
          <circle cx="330" cy="161" r="117" stroke="#FFFFFF" stroke-opacity=".08"/>
          <path d="M330 44V91M447 161H401M330 278V231M213 161H259" stroke="#FFFFFF" stroke-opacity=".44" stroke-width="2"/>
          <circle cx="330" cy="161" r="8" fill="#F18732"/>
          <path d="M474 83h111M520 111h65M76 338h105M76 363h66" stroke="#FFFFFF" stroke-opacity=".28" stroke-width="2"/>
          <path d="M476 83h35" stroke="#F18732" stroke-width="3"/>
          <text x="475" y="68" fill="#FFFFFF" fill-opacity=".58" font-size="11" letter-spacing="2">SYSTEMS</text>
          <text x="77" y="326" fill="#FFFFFF" fill-opacity=".58" font-size="11" letter-spacing="2">ANALYSIS</text>
        </svg>
        <div class="art-caption"><span class="caption-mark"></span><span>{locale === 'fr' ? 'Concevoir · Valider · Réaliser' : locale === 'en' ? 'Design · Validate · Deliver' : 'Progettare · Validare · Realizzare'}</span></div>
      </div>
      <div class="hero-bottom"><span>MECHANICAL ENGINEERING</span><span>CONSULTING</span><span>PROJECT MANAGEMENT</span></div>
    </section>

    <section class="intro-section section-wrap">
      <div class="section-label"><span class="eyebrow">{t.introEyebrow}</span><span class="section-index">01 / 03</span></div>
      <div class="intro-content"><h2>{t.introTitle}</h2><p>{t.introText}</p><a class="text-link" href="#services">{t.navServices}<span aria-hidden="true">↓</span></a></div>
    </section>

    <section id="services" class="services-section section-wrap">
      <div class="section-heading"><div><p class="eyebrow">{t.servicesEyebrow}</p><h2>{t.servicesTitle}</h2></div><span class="section-index">02 / 03</span></div>
      <div class="service-grid">
        {t.serviceItems.map(([number, title, body]) => (
          <article class="service-card">
            <div class="service-card-top"><span>{number}</span><span class="service-arrow" aria-hidden="true">↗</span></div>
            <div><h3>{title}</h3><p>{body}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="expertise-section">
      <div class="expertise-inner section-wrap">
        <div class="expertise-title"><p class="eyebrow">{t.expertiseEyebrow}</p><h2>{t.expertiseTitle}</h2><div class="small-rule"></div></div>
        <div class="expertise-list">
          {t.expertiseItems.map(([title, body], index) => (
            <article class="expertise-row"><span class="expertise-number">0{index + 1}</span><div><h3>{title}</h3><p>{body}</p></div><span class="row-arrow" aria-hidden="true">↗</span></article>
          ))}
        </div>
      </div>
    </section>

    <section class="values-section section-wrap">
      <div><p class="eyebrow">{t.valuesEyebrow}</p><h2>{t.valuesTitle}</h2></div>
      <p>{t.valuesText}</p>
      <div class="values-stamp" aria-hidden="true"><span>G</span><i></i></div>
    </section>

    <section id="contact" class="contact-section">
      <div class="contact-inner section-wrap">
        <div class="contact-copy"><p class="eyebrow">{t.contactEyebrow}</p><h2>{t.contactTitle}</h2><p>{t.contactText}</p><a class="button button-orange" href="mailto:giovanni@giovannimalagninoconsulting.com" data-analytics-event="contact_cta" data-analytics-name="contact">{t.email}<span aria-hidden="true">↗</span></a></div>
        <div class="contact-details">
          <a class="contact-email" href="mailto:giovanni@giovannimalagninoconsulting.com">giovanni@giovannimalagninoconsulting.com</a>
          <div class="contact-countries"><div><span>{t.italy}</span><a href="tel:+393927290392">+39 392 729 0392</a></div><div><span>{t.canada}</span><a href="tel:+14384480997">+1 438 448 0997</a></div></div>
          <a class="linkedin-link" href="https://www.linkedin.com/in/giovannimalagnino/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
