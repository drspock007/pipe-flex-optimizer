---
import { Font } from 'astro:assets';
import { copy, isLocale, localeNames, locales, paths, type Locale } from '../data/content';
import { gaMeasurementId } from '../data/legal';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  locale: Locale;
  page: 'home' | 'calculators' | 'privacy' | 'cookies' | 'notFound';
  title?: string;
  description?: string;
  active?: 'home' | 'calculators';
  noIndex?: boolean;
}

const { locale, page, title, description, active, noIndex = false } = Astro.props;
const t = copy[locale];
const canonicalPath = page === 'home' || page === 'notFound' ? paths.home(locale) : page === 'calculators' ? paths.calculators(locale) : page === 'privacy' ? paths.privacy(locale) : paths.cookies(locale);
const canonical = new URL(canonicalPath, 'https://giovannimalagninoconsulting.com').toString();
const pageTitle = title ?? (page === 'home' ? `${t.title} | GMC` : page === 'calculators' ? `${t.calculatorPageTitle} | GMC` : page === 'privacy' ? `${t.privacyTitle} | GMC` : page === 'cookies' ? `${t.cookieTitle} | GMC` : `${t.notFoundTitle} | GMC`);
const pageDescription = description ?? (page === 'calculators' ? t.calculatorPageDescription : page === 'privacy' ? t.privacyLead : page === 'cookies' ? t.cookieLead : t.description);
const languagePath = (target: Locale) => page === 'home' ? paths.home(target) : page === 'calculators' ? paths.calculators(target) : page === 'privacy' ? paths.privacy(target) : page === 'cookies' ? paths.cookies(target) : paths.home(target);
const id = /^G-[A-Z0-9]+$/.test(gaMeasurementId) ? gaMeasurementId : '';
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Giovanni Malagnino Consulting',
  url: 'https://giovannimalagninoconsulting.com/',
  email: 'giovanni@giovannimalagninoconsulting.com',
  sameAs: ['https://www.linkedin.com/in/giovannimalagnino/', 'https://www.facebook.com/giovannimalagninoconsulting'],
};
if (!isLocale(locale)) throw new Error(`Unsupported locale: ${locale}`);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fd7a0b" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {locales.map((code) => <link rel="alternate" hreflang={code} href={new URL(languagePath(code), 'https://giovannimalagninoconsulting.com').toString()} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(paths.home('fr'), 'https://giovannimalagninoconsulting.com').toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Giovanni Malagnino Consulting" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://giovannimalagninoconsulting.com/brand-mark.png" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-heading" preload />
    <Font cssVariable="--font-body" preload />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === 'fr' ? 'Aller au contenu' : locale === 'en' ? 'Skip to content' : 'Vai al contenuto'}</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={paths.home(locale)} aria-label={`Giovanni Malagnino Consulting — ${t.navHome}`}>
          <img src="/brand-mark.png" alt="" width="56" height="56" />
          <span class="brand-copy"><strong>Giovanni Malagnino</strong><small>CONSULTING</small></span>
        </a>
        <nav class="desktop-nav" aria-label={locale === 'fr' ? 'Navigation principale' : locale === 'en' ? 'Main navigation' : 'Navigazione principale'}>
          <a class:list={['nav-link', { active: active === 'home' }]} href={paths.home(locale)}>{t.navHome}</a>
          {page === 'home' && <a class="nav-link" href="#services">{t.navServices}</a>}
          <a class:list={['nav-link', { active: active === 'calculators' }]} href={paths.calculators(locale)}>{t.navCalculators}</a>
          <a class="nav-contact" href={paths.home(locale) + '#contact'}>{t.navContact}<span aria-hidden="true">↗</span></a>
          <div class="language-picker" role="group" aria-label={locale === 'fr' ? 'Langue' : locale === 'en' ? 'Language' : 'Lingua'}>
            {locales.map((code) => <a href={languagePath(code)} aria-current={code === locale ? 'page' : undefined} lang={code}>{code.toUpperCase()}</a>)}
          </div>
        </nav>
        <details class="mobile-menu">
          <summary aria-label={locale === 'fr' ? 'Ouvrir le menu' : locale === 'en' ? 'Open menu' : 'Apri il menu'}><span></span><span></span></summary>
          <nav aria-label={locale === 'fr' ? 'Navigation principale' : locale === 'en' ? 'Main navigation' : 'Navigazione principale'}>
            <a href={paths.home(locale)}>{t.navHome}</a>
            {page === 'home' && <a href="#services">{t.navServices}</a>}
            <a href={paths.calculators(locale)}>{t.navCalculators}</a>
            <a href={paths.home(locale) + '#contact'}>{t.navContact}</a>
            <div class="language-picker" role="group" aria-label={locale === 'fr' ? 'Langue' : locale === 'en' ? 'Language' : 'Lingua'}>{locales.map((code) => <a href={languagePath(code)} aria-current={code === locale ? 'page' : undefined} lang={code}>{localeNames[code]}</a>)}</div>
          </nav>
        </details>
      </header>
      <slot />
      <footer class="site-footer">
        <div class="footer-top">
          <a class="brand footer-brand" href={paths.home(locale)}>
            <img src="/brand-mark.png" alt="" width="48" height="48" />
            <span class="brand-copy"><strong>Giovanni Malagnino</strong><small>CONSULTING</small></span>
          </a>
          <p>{t.footerTagline}</p>
          <a class="footer-email" href="mailto:giovanni@giovannimalagninoconsulting.com">giovanni@giovannimalagninoconsulting.com <span aria-hidden="true">↗</span></a>
        </div>
        <div class="footer-locations">
          <span>{t.italy}: <a href="tel:+393927290392">+39 392 729 0392</a></span>
          <span>{t.canada}: <a href="tel:+14384480997">+1 438 448 0997</a></span>
          <span class="social-links"><a href="https://www.linkedin.com/in/giovannimalagnino/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="https://www.facebook.com/giovannimalagninoconsulting" target="_blank" rel="noopener noreferrer">Facebook ↗</a></span>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Giovanni Malagnino Consulting. {t.rights}.</span>
          <div><a href={paths.privacy(locale)}>{t.privacyTitle}</a><a href={paths.cookies(locale)}>{t.cookieTitle}</a><button type="button" data-consent-open>{t.cookiePrefs}</button></div>
        </div>
      </footer>
    </div>
    <CookieConsent locale={locale} gaId={id} />
  </body>
</html>
