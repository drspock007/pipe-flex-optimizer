---
import { copy, paths, type Locale } from '../data/content';
import { consentCookieName, consentMaxAgeSeconds } from '../data/legal';
const { locale, gaId } = Astro.props as { locale: Locale; gaId: string };
const t = copy[locale];
---
<section class="consent-banner" data-consent-banner data-locale={locale} data-ga-id={gaId} data-cookie-name={consentCookieName} data-cookie-age={consentMaxAgeSeconds} aria-label={t.cookieBannerTitle} hidden>
  <div class="consent-copy">
    <p class="eyebrow">{t.policyTitle}</p>
    <h2>{t.cookieBannerTitle}</h2>
    <p>{t.cookieBannerText}</p>
    <a href={paths.cookies(locale)}>{t.cookieTitle} ↗</a>
  </div>
  <div class="consent-actions">
    <button class="button button-dark" type="button" data-consent-accept>{t.acceptAll}</button>
    <button class="button button-outline" type="button" data-consent-reject>{t.rejectAll}</button>
    <button class="button button-text" type="button" data-consent-customize>{t.customize}</button>
  </div>
  <div class="consent-preferences" data-consent-preferences hidden>
    <div class="consent-category"><div><strong>{t.required}</strong><p>{t.alwaysOn}</p></div><input type="checkbox" checked disabled aria-label={t.required} /></div>
    <label class="consent-category"><span><strong>{t.analyticsConsent}</strong><small>{t.analyticsTitle}</small></span><input type="checkbox" data-consent-analytics /></label>
    <div class="consent-preference-actions"><button class="button button-outline" type="button" data-consent-back>{t.back}</button><button class="button button-dark" type="button" data-consent-save>{t.saveChoices}</button></div>
  </div>
</section>
<script>
  type ConsentChoice = { analytics: boolean; updatedAt: string };
  const banner = document.querySelector<HTMLElement>('[data-consent-banner]');
  if (banner) {
    const storageName = banner.dataset.cookieName ?? 'gmc_consent';
    const maxAge = Number(banner.dataset.cookieAge ?? 15552000);
    const analyticsId = banner.dataset.gaId ?? '';
    const preferencePanel = banner.querySelector<HTMLElement>('[data-consent-preferences]');
    const analyticsToggle = banner.querySelector<HTMLInputElement>('[data-consent-analytics]');
    const cookieValue = () => {
      const pair = document.cookie.split('; ').find((item) => item.startsWith(`${storageName}=`));
      if (!pair) return null;
      try { return JSON.parse(decodeURIComponent(pair.slice(storageName.length + 1))) as ConsentChoice; }
      catch { return null; }
    };
    const saveChoice = (analytics: boolean) => {
      const value = encodeURIComponent(JSON.stringify({ analytics, updatedAt: new Date().toISOString() }));
      const secure = window.location.protocol === 'https:' ? '; Secure' : '';
      document.cookie = `${storageName}=${value}; Max-Age=${maxAge}; Path=/; SameSite=Lax${secure}`;
      banner.hidden = true;
      preferencePanel?.setAttribute('hidden', '');
      if (analytics) loadAnalytics();
      else disableAnalytics();
    };
    const disableAnalytics = () => {
      if (!/^G-[A-Z0-9]+$/.test(analyticsId)) return;
      const globals = window as typeof window & { [key: string]: unknown };
      globals[`ga-disable-${analyticsId}`] = true;
      const secure = window.location.protocol === 'https:' ? '; Secure' : '';
      const analyticsCookies = document.cookie.split(';').map((entry) => entry.split('=')[0]?.trim()).filter((name): name is string => Boolean(name) && (name === '_ga' || name.startsWith('_ga_')));
      for (const name of analyticsCookies) {
        document.cookie = `${name}=; Max-Age=0; Path=/; SameSite=Lax${secure}`;
        document.cookie = `${name}=; Max-Age=0; Path=/; Domain=.giovannimalagninoconsulting.com; SameSite=Lax${secure}`;
      }
    };
    const loadAnalytics = () => {
      if (!/^G-[A-Z0-9]+$/.test(analyticsId) || document.querySelector('[data-ga-loaded]')) return;
      const globals = window as typeof window & { [key: string]: unknown };
      globals[`ga-disable-${analyticsId}`] = false;
      const dataLayer = (window as typeof window & { dataLayer?: unknown[]; gtag?: (...args: unknown[]) => void }).dataLayer ?? [];
      (window as typeof window & { dataLayer?: unknown[]; gtag?: (...args: unknown[]) => void }).dataLayer = dataLayer;
      const gtag = (...args: unknown[]) => dataLayer.push(args);
      (window as typeof window & { gtag?: (...args: unknown[]) => void }).gtag = gtag;
      gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
      gtag('consent', 'update', { analytics_storage: 'granted', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
      gtag('js', new Date());
      gtag('config', analyticsId, { anonymize_ip: true, cookie_expires: maxAge, send_page_view: true });
      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${analyticsId}`;
      script.dataset.gaLoaded = 'true';
      document.head.append(script);
    };
    const openSettings = () => {
      banner.hidden = false;
      if (analyticsToggle) analyticsToggle.checked = cookieValue()?.analytics ?? false;
      preferencePanel?.removeAttribute('hidden');
      banner.querySelector<HTMLButtonElement>('[data-consent-customize]')?.focus();
    };
    const storedChoice = cookieValue();
    if (!storedChoice) banner.hidden = false;
    else if (storedChoice.analytics) loadAnalytics();
    document.querySelectorAll<HTMLButtonElement>('[data-consent-open]').forEach((button) => button.addEventListener('click', openSettings));
    banner.querySelector('[data-consent-accept]')?.addEventListener('click', () => saveChoice(true));
    banner.querySelector('[data-consent-reject]')?.addEventListener('click', () => saveChoice(false));
    banner.querySelector('[data-consent-customize]')?.addEventListener('click', openSettings);
    banner.querySelector('[data-consent-back]')?.addEventListener('click', () => preferencePanel?.setAttribute('hidden', ''));
    banner.querySelector('[data-consent-save]')?.addEventListener('click', () => saveChoice(analyticsToggle?.checked ?? false));
    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-analytics-event]') : null;
      if (!target) return;
      const gtag = (window as typeof window & { gtag?: (...args: unknown[]) => void }).gtag;
      if (cookieValue()?.analytics && gtag) gtag('event', target.dataset.analyticsEvent, { item_name: target.dataset.analyticsName ?? undefined });
    });
  }
</script>
